# ─── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Storage (optional) ──────────────────────────────────────────────────────
# STORAGE_MODE: sqlite (production), json (development), or dual-write (migration)
# Default: sqlite
STORAGE_MODE=sqlite

# SQLITE_DB_PATH: path to SQLite database file
# Default: data/cortege.db
SQLITE_DB_PATH=data/cortege.db

# ENABLE_JSON_FALLBACK: fall back to JSON files if SQLite fails
# Default: false
ENABLE_JSON_FALLBACK=false

# ─── Claude model (optional) ─────────────────────────────────────────────────
# Default: claude-haiku-4-5-20251001
# Switch to claude-sonnet-4-6 for higher quality demo assessments
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Server (optional) ───────────────────────────────────────────────────────
# Default: 3001
PORT=3001

# ─── Accelerated learning / demo mode (optional) ─────────────────────────────
# LEARNING_TIME_MULTIPLIER: 1 real minute = N simulated minutes (default 1440 = 1 day)
LEARNING_TIME_MULTIPLIER=1440

# LEARNING_EVENT_WEIGHT: each event counts as N events for depth score (default 10)
LEARNING_EVENT_WEIGHT=10

# LEARNING_FAST_MODE: lower stage transition thresholds for visible demo progression
# Baseline→Pattern at 0.10, Pattern→Predictive at 0.25, Predictive→Cortege at 0.50
LEARNING_FAST_MODE=true

# ─── Twilio (optional — plug in when account is configured) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
