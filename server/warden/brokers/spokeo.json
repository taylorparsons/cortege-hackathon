{
  "id": "spokeo",
  "name": "Spokeo",
  "search_url": "https://www.spokeo.com/{first_name}-{last_name}",
  "opt_out_url": "https://www.spokeo.com/optout",
  "requires_pii": ["name", "city", "state"],
  "verification_method": "email",
  "version": "2026-03-01",
  "last_verified": "2026-03-23",
  "associate_selectors": {
    "container": ".possible-relatives .relative-card, .associates .person-listing, .relative-section li",
    "name": ".relative-name, .person-name a, .associate-name",
    "relationship": ".relationship, .relative-type, .relation-label"
  },
  "steps": [
    {
      "action": "web_search",
      "engine": "duckduckgo",
      "query": "\"{name}\" site:spokeo.com",
      "result_selector": ".result__body, .result__title, .results_links",
      "skip_if_no_results": true,
      "timeout_ms": 12000,
      "_comment": "Phase 1: threat assessment — confirm Spokeo has a listing for this member"
    },
    {
      "action": "navigate",
      "url": "https://www.spokeo.com/{first_name}-{last_name}",
      "timeout_ms": 15000,
      "_comment": "Phase 2: public people-search — see actual listing and extract associates"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running"]
    },
    { "action": "wait", "selector": ".profile-list, .person-card, .name-block, .no-results-message", "timeout_ms": 10000 },
    { "action": "extract_associates" },
    {
      "action": "navigate",
      "url": "https://www.spokeo.com/optout",
      "timeout_ms": 15000,
      "_comment": "Phase 3: opt-out form"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running"]
    },
    { "action": "fill", "selector": "input#first_name, input[name='first_name'], input[placeholder*='First' i]", "value_source": "member.first_name" },
    { "action": "fill", "selector": "input#last_name, input[name='last_name'], input[placeholder*='Last' i]", "value_source": "member.last_name" },
    { "action": "fill", "selector": "input#city, input[name='city'], input[placeholder*='city' i]", "value_source": "member.city" },
    { "action": "fill", "selector": "input#state, input[name='state'], input[placeholder*='state' i]", "value_source": "member.state" },
    { "action": "click", "selector": "button[type='submit'], input[type='submit']" },
    { "action": "wait", "selector": ".search-results, .profile-list, .no-results-message, .optout-results", "timeout_ms": 10000 },
    { "action": "click", "selector": ".remove-listing, a[href*='remove'], button.opt-out-btn, .opt-out-this-result" },
    { "action": "wait", "selector": ".success, .removal-confirmed, .opt-out-confirmed", "timeout_ms": 10000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:Your listing has been removed",
        "text:opt-out request",
        "text:successfully removed",
        "selector:.removal-success"
      ]
    }
  ]
}
