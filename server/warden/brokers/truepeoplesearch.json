{
  "id": "truepeoplesearch",
  "name": "TruePeopleSearch",
  "search_url": "https://www.truepeoplesearch.com/results?name={name}&citystatezip={city_state}",
  "opt_out_url": "https://www.truepeoplesearch.com/removal",
  "requires_pii": ["name", "city_state"],
  "verification_method": "none",
  "version": "2026-03-01",
  "last_verified": "2026-03-23",
  "associate_selectors": {
    "container": ".card-block .relativeNames, .associates-section, .relative-names-container",
    "name": ".relativeNames a, .associate-name, .relative-name",
    "relationship": ".relationship-label"
  },
  "steps": [
    {
      "action": "web_search",
      "engine": "duckduckgo",
      "query": "\"{name}\" site:truepeoplesearch.com",
      "result_selector": ".result__body, .result__title, .results_links",
      "skip_if_no_results": true,
      "timeout_ms": 12000,
      "_comment": "Phase 1: threat assessment — confirm TruePeopleSearch has a record for this member"
    },
    {
      "action": "navigate",
      "url": "https://www.truepeoplesearch.com/results?name={name}&citystatezip={city_state}",
      "timeout_ms": 15000,
      "_comment": "Phase 2: search results page — see actual listing and extract relatives"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running", ".cf-challenge-running"]
    },
    { "action": "wait", "selector": ".card-block, .results-list, .no-results", "timeout_ms": 10000 },
    { "action": "extract_associates" },
    {
      "action": "navigate",
      "url": "https://www.truepeoplesearch.com/removal",
      "timeout_ms": 15000,
      "_comment": "Phase 3: dedicated removal page"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running", ".cf-challenge-running"]
    },
    { "action": "fill", "selector": "input[name='name'], #fullname, input[placeholder*='name' i]", "value_source": "member.name" },
    { "action": "fill", "selector": "input[name='citystate'], #location, input[placeholder*='city' i]", "value_source": "member.city_state" },
    { "action": "click", "selector": "button[type='submit'], .btnSearchRecords, .search-btn" },
    { "action": "wait", "selector": ".card-block, .results-list, .no-results", "timeout_ms": 10000 },
    { "action": "click", "selector": "a[href*='removal'], button.btn-remove, .remove-record-link" },
    { "action": "wait", "selector": ".removal-confirmation, .success-alert, .alert-success", "timeout_ms": 10000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:Your record has been removed",
        "text:removal request submitted",
        "text:successfully removed",
        "selector:.alert-success"
      ]
    }
  ]
}
