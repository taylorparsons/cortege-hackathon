{
  "id": "fastpeoplesearch",
  "name": "FastPeopleSearch",
  "search_url": "https://www.fastpeoplesearch.com/name/{name}",
  "opt_out_url": "https://www.fastpeoplesearch.com/removal",
  "requires_pii": ["name", "state"],
  "verification_method": "none",
  "version": "2026-03-01",
  "last_verified": "2026-03-23",
  "associate_selectors": {
    "container": ".relatives-container .relative-card, .associates-list li, .possible-relatives li",
    "name": ".relative-name a, .associate-name, .person-name",
    "relationship": ".relative-relationship, .relation-label"
  },
  "steps": [
    {
      "action": "web_search",
      "engine": "duckduckgo",
      "query": "\"{name}\" site:fastpeoplesearch.com",
      "result_selector": ".result__body, .result__title, .results_links",
      "skip_if_no_results": true,
      "timeout_ms": 12000,
      "_comment": "Phase 1: threat assessment — confirm FastPeopleSearch has a record for this member"
    },
    {
      "action": "navigate",
      "url": "https://www.fastpeoplesearch.com/name/{name}",
      "timeout_ms": 15000,
      "_comment": "Phase 2: public name search — see record and extract relatives"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running", ".cf-challenge-running"]
    },
    { "action": "wait", "selector": ".profile-card, .person-card, .card-block, .no-results", "timeout_ms": 10000 },
    { "action": "extract_associates" },
    {
      "action": "navigate",
      "url": "https://www.fastpeoplesearch.com/removal",
      "timeout_ms": 15000,
      "_comment": "Phase 3: removal request form"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running", ".cf-challenge-running"]
    },
    { "action": "fill", "selector": "input[name='name'], #search-name, input[placeholder*='name' i]", "value_source": "member.name" },
    { "action": "fill", "selector": "input[name='state'], #search-state, input[placeholder*='state' i]", "value_source": "member.state" },
    { "action": "click", "selector": "button[type='submit'], #search-submit, .search-btn" },
    { "action": "wait", "selector": ".profile-card, .person-card, .no-results", "timeout_ms": 10000 },
    { "action": "click", "selector": ".remove-record, a[href*='remove'], .opt-out-button, button[data-action='remove']" },
    { "action": "wait", "selector": ".removal-confirmation, .success, .request-received", "timeout_ms": 10000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:Record has been removed",
        "text:successfully removed",
        "text:removal request",
        "selector:.removal-success"
      ]
    }
  ]
}
