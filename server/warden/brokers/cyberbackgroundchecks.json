{
  "id": "cyberbackgroundchecks",
  "name": "CyberBackgroundChecks",
  "search_url": "https://www.cyberbackgroundchecks.com/people/{name}/{state}",
  "opt_out_url": "https://www.cyberbackgroundchecks.com/removal",
  "requires_pii": ["name", "state"],
  "requires_headed_mode": true,
  "verification_method": "none",
  "version": "2026-03-25",
  "last_verified": "2026-03-25",
  "associate_selectors": {
    "container": ".relatives .relative, .possible-relatives li, .associates-section li",
    "name": ".relative-name a, .associate-name, .person-name",
    "relationship": ".relationship, .relative-type, .relation-label"
  },
  "steps": [
    {
      "action": "web_search",
      "engine": "duckduckgo",
      "query": "\"{name}\" site:cyberbackgroundchecks.com",
      "result_selector": ".result__body, .result__title, .results_links",
      "skip_if_no_results": true,
      "timeout_ms": 12000,
      "_comment": "Phase 1: threat assessment — confirm CyberBackgroundChecks has a record for this member"
    },
    {
      "action": "navigate",
      "url": "https://www.cyberbackgroundchecks.com/people/{name}/{state}",
      "timeout_ms": 15000,
      "_comment": "Phase 2: public people-search — see what PII is exposed and extract associates"
    },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running",
        ".cf-challenge-running"
      ]
    },
    {
      "action": "wait",
      "selector": ".people-list, .person-card, .result-card, .no-results",
      "timeout_ms": 10000
    },
    { "action": "extract_associates" },
    {
      "action": "navigate",
      "url": "https://www.cyberbackgroundchecks.com/removal",
      "timeout_ms": 15000,
      "_comment": "Phase 3: removal request form"
    },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running",
        ".cf-challenge-running"
      ]
    },
    {
      "action": "fill",
      "selector": "input[name='firstName'], input[placeholder*='First' i], input[id*='first' i]",
      "value_source": "member.first_name"
    },
    {
      "action": "fill",
      "selector": "input[name='lastName'], input[placeholder*='Last' i], input[id*='last' i]",
      "value_source": "member.last_name"
    },
    {
      "action": "fill",
      "selector": "input[name='state'], select[name='state'], select[id*='state' i]",
      "value_source": "member.state"
    },
    {
      "action": "click",
      "selector": "button[type='submit'], input[type='submit'], .search-btn, .btn-search"
    },
    {
      "action": "wait",
      "selector": ".search-results, .people-list, .record-list, .no-results",
      "timeout_ms": 10000
    },
    {
      "action": "click",
      "selector": ".remove-record, a[href*='remove'], .opt-out-link, button[data-action='remove']"
    },
    {
      "action": "wait",
      "selector": ".confirmation, .success-message, .removal-success",
      "timeout_ms": 10000
    },
    {
      "action": "detect_success",
      "indicators": [
        "text:removal request",
        "text:successfully removed",
        "text:record has been removed",
        "text:opt-out",
        "selector:.success-message"
      ]
    }
  ]
}
