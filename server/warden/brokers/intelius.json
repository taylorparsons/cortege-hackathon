{
  "id": "intelius",
  "name": "Intelius",
  "search_url": "https://www.intelius.com/people-search/name/{name}",
  "opt_out_url": "https://www.intelius.com/opt-out",
  "requires_pii": ["name", "address"],
  "verification_method": "email",
  "version": "2026-03-01",
  "last_verified": "2026-03-20",
  "associate_selectors": {
    "container": ".relative-cards .card, .possible-relatives li",
    "name": ".relative-name, .name a",
    "relationship": ".relation"
  },
  "steps": [
    { "action": "navigate", "url": "https://www.intelius.com/opt-out" },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running"
      ]
    },
    { "action": "fill", "selector": "input[name='firstName'], input[placeholder*='First' i]", "value_source": "member.first_name" },
    { "action": "fill", "selector": "input[name='lastName'], input[placeholder*='Last' i]", "value_source": "member.last_name" },
    { "action": "fill", "selector": "input[name='state'], select#state", "value_source": "member.state" },
    { "action": "click", "selector": "button[type='submit'], .search-button" },
    { "action": "wait", "selector": ".results-container, .profile-list, .no-results", "timeout_ms": 8000 },
    { "action": "extract_associates" },
    { "action": "click", "selector": ".remove-button, a.opt-out, button[data-action='optout']" },
    { "action": "wait", "selector": ".success, .removal-complete", "timeout_ms": 8000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:Your request has been submitted",
        "text:opt-out successful",
        "text:record removed",
        "selector:.success-container"
      ]
    }
  ]
}
