{
  "id": "intelius",
  "name": "Intelius",
  "search_url": "https://www.intelius.com/people-search/name/{name}",
  "opt_out_url": "https://www.intelius.com/opt-out",
  "requires_pii": ["name", "state"],
  "verification_method": "email",
  "version": "2026-03-01",
  "last_verified": "2026-03-23",
  "associate_selectors": {
    "container": ".relative-cards .card, .possible-relatives li, .relatives-list li",
    "name": ".relative-name, .name a, .person-name",
    "relationship": ".relation, .relationship-label"
  },
  "steps": [
    {
      "action": "web_search",
      "engine": "duckduckgo",
      "query": "\"{name}\" site:intelius.com",
      "result_selector": ".result__body, .result__title, .results_links",
      "skip_if_no_results": true,
      "timeout_ms": 12000,
      "_comment": "Phase 1: threat assessment — confirm Intelius has a record for this member"
    },
    {
      "action": "navigate",
      "url": "https://www.intelius.com/people-search/name/{name}",
      "timeout_ms": 15000,
      "_comment": "Phase 2: public people-search — see exposed listing and extract relatives"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running"]
    },
    { "action": "wait", "selector": ".results-container, .profile-list, .result-card, .no-results", "timeout_ms": 10000 },
    { "action": "extract_associates" },
    {
      "action": "navigate",
      "url": "https://www.intelius.com/opt-out",
      "timeout_ms": 15000,
      "_comment": "Phase 3: opt-out form"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running"]
    },
    { "action": "fill", "selector": "input[name='firstName'], input[placeholder*='First' i]", "value_source": "member.first_name" },
    { "action": "fill", "selector": "input[name='lastName'], input[placeholder*='Last' i]", "value_source": "member.last_name" },
    { "action": "fill", "selector": "input[name='state'], select#state, select[name='state']", "value_source": "member.state" },
    { "action": "click", "selector": "button[type='submit'], .search-button" },
    { "action": "wait", "selector": ".results-container, .profile-list, .no-results", "timeout_ms": 10000 },
    { "action": "click", "selector": ".remove-button, a.opt-out, button[data-action='optout']" },
    { "action": "wait", "selector": ".success, .removal-complete", "timeout_ms": 10000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:Your request has been submitted",
        "text:opt-out successful",
        "text:record removed",
        "selector:.success-container"
      ]
    }
  ]
}
