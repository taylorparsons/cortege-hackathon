{
  "id": "beenverified",
  "name": "BeenVerified",
  "search_url": "https://www.beenverified.com/people/{name}",
  "opt_out_url": "https://www.beenverified.com/app/optout/search",
  "requires_pii": ["name", "address"],
  "verification_method": "email",
  "version": "2026-03-01",
  "last_verified": "2026-03-20",
  "associate_selectors": {
    "container": ".possible-relatives, .associates-section",
    "name": ".relative-name, .associate-name a",
    "relationship": ".relationship-type"
  },
  "steps": [
    { "action": "navigate", "url": "https://www.beenverified.com/app/optout/search" },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running"
      ]
    },
    { "action": "fill", "selector": "input[name='fname'], input[placeholder*='First Name' i]", "value_source": "member.first_name" },
    { "action": "fill", "selector": "input[name='lname'], input[placeholder*='Last Name' i]", "value_source": "member.last_name" },
    { "action": "fill", "selector": "input[name='state'], select[name='state']", "value_source": "member.state" },
    { "action": "click", "selector": "button[type='submit'], .search-submit" },
    { "action": "wait", "selector": ".search-results, .optout-result, .no-records", "timeout_ms": 10000 },
    { "action": "extract_associates" },
    { "action": "click", "selector": ".opt-out-button, input[type='radio'][value='optout'], a[href*='optout']" },
    { "action": "click", "selector": "button.proceed-optout, button[type='submit']" },
    { "action": "wait", "selector": ".optout-confirmation, .success-message", "timeout_ms": 8000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:opt-out request has been received",
        "text:successfully opted out",
        "text:removal request",
        "selector:.optout-success"
      ]
    }
  ]
}
