{
  "id": "ussearch",
  "name": "USSearch",
  "search_url": "https://www.ussearch.com/people/{name}",
  "opt_out_url": "https://www.ussearch.com/opt-out/submit/",
  "requires_pii": ["name", "address"],
  "verification_method": "email",
  "version": "2026-03-01",
  "last_verified": "2026-03-20",
  "associate_selectors": {
    "container": ".possible-relatives, .associates",
    "name": ".name a, .associate-name",
    "relationship": ".relationship"
  },
  "steps": [
    { "action": "navigate", "url": "https://www.ussearch.com/opt-out/submit/" },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running"
      ]
    },
    { "action": "fill", "selector": "input[name='firstname'], input[placeholder*='First' i]", "value_source": "member.first_name" },
    { "action": "fill", "selector": "input[name='lastname'], input[placeholder*='Last' i]", "value_source": "member.last_name" },
    { "action": "fill", "selector": "input[name='state'], select[name='state']", "value_source": "member.state" },
    { "action": "click", "selector": "button[type='submit'], input[type='submit']" },
    { "action": "wait", "selector": ".results, .search-result, .no-result", "timeout_ms": 8000 },
    { "action": "extract_associates" },
    { "action": "click", "selector": "input[type='radio'][name='record'], .select-record" },
    { "action": "click", "selector": "button[type='submit'], .opt-out-submit" },
    { "action": "wait", "selector": ".confirmation, .success", "timeout_ms": 8000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:opt-out request",
        "text:successfully submitted",
        "text:removal submitted",
        "selector:.confirmation-message"
      ]
    }
  ]
}
