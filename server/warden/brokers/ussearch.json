{
  "id": "ussearch",
  "name": "USSearch",
  "search_url": "https://www.ussearch.com/people/{name}",
  "opt_out_url": "https://www.ussearch.com/opt-out/submit/",
  "requires_pii": ["name", "state"],
  "verification_method": "email",
  "version": "2026-03-01",
  "last_verified": "2026-03-23",
  "associate_selectors": {
    "container": ".possible-relatives, .associates, .relative-section li",
    "name": ".name a, .associate-name, .relative-name",
    "relationship": ".relationship, .relation-label"
  },
  "steps": [
    {
      "action": "web_search",
      "engine": "duckduckgo",
      "query": "\"{name}\" site:ussearch.com",
      "result_selector": ".result__body, .result__title, .results_links",
      "skip_if_no_results": true,
      "timeout_ms": 12000,
      "_comment": "Phase 1: threat assessment — confirm USSearch has a record for this member"
    },
    {
      "action": "navigate",
      "url": "https://www.ussearch.com/people/{name}",
      "timeout_ms": 15000,
      "_comment": "Phase 2: public people search — see listing and extract associates"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running"]
    },
    { "action": "wait", "selector": ".results, .search-result, .person-card, .no-result", "timeout_ms": 10000 },
    { "action": "extract_associates" },
    {
      "action": "navigate",
      "url": "https://www.ussearch.com/opt-out/submit/",
      "timeout_ms": 15000,
      "_comment": "Phase 3: opt-out submission form"
    },
    {
      "action": "detect_captcha",
      "selectors": ["iframe[src*='recaptcha']", ".g-recaptcha", "iframe[src*='hcaptcha']", "#challenge-running"]
    },
    { "action": "fill", "selector": "input[name='firstname'], input[placeholder*='First' i]", "value_source": "member.first_name" },
    { "action": "fill", "selector": "input[name='lastname'], input[placeholder*='Last' i]", "value_source": "member.last_name" },
    { "action": "fill", "selector": "input[name='state'], select[name='state']", "value_source": "member.state" },
    { "action": "click", "selector": "button[type='submit'], input[type='submit']" },
    { "action": "wait", "selector": ".results, .search-result, .no-result", "timeout_ms": 10000 },
    { "action": "click", "selector": "input[type='radio'][name='record'], .select-record, button[data-select-record]" },
    { "action": "click", "selector": "button[type='submit'], .opt-out-submit, .proceed-btn" },
    { "action": "wait", "selector": ".confirmation, .success", "timeout_ms": 10000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:opt-out request",
        "text:successfully submitted",
        "text:removal submitted",
        "selector:.confirmation-message"
      ]
    }
  ]
}
