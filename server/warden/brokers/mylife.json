{
  "id": "mylife",
  "name": "MyLife",
  "search_url": "https://www.mylife.com/find-person/{name}",
  "opt_out_url": "https://www.mylife.com/privacy/index.mvc",
  "requires_pii": ["name", "address"],
  "verification_method": "email",
  "version": "2026-03-01",
  "last_verified": "2026-03-20",
  "associate_selectors": {
    "container": ".possible-relatives, .known-associates",
    "name": ".relative-name, h4.person-name",
    "relationship": ".relation-label"
  },
  "steps": [
    { "action": "navigate", "url": "https://www.mylife.com/privacy/index.mvc" },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running"
      ]
    },
    { "action": "fill", "selector": "input[name='firstName'], input[id='firstName']", "value_source": "member.first_name" },
    { "action": "fill", "selector": "input[name='lastName'], input[id='lastName']", "value_source": "member.last_name" },
    { "action": "fill", "selector": "input[name='email'], input[id='email']", "value_source": "member.email" },
    { "action": "fill", "selector": "input[name='city'], input[id='city']", "value_source": "member.city" },
    { "action": "click", "selector": "button[type='submit'], .submit-removal" },
    { "action": "wait", "selector": ".results, .profile-found, .no-profile", "timeout_ms": 8000 },
    { "action": "extract_associates" },
    { "action": "click", "selector": ".remove-my-info, a[href*='remove'], .opt-out-link" },
    {
      "action": "detect_success",
      "indicators": [
        "text:Your information has been removed",
        "text:removal request received",
        "text:successfully submitted",
        "selector:.success-banner"
      ]
    }
  ]
}
