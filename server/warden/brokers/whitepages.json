{
  "id": "whitepages",
  "name": "WhitePages",
  "search_url": "https://www.whitepages.com/name/{name}/{state}",
  "opt_out_url": "https://www.whitepages.com/suppression-requests",
  "requires_pii": ["name", "state"],
  "verification_method": "phone_call",
  "version": "2026-03-01",
  "last_verified": "2026-03-23",
  "associate_selectors": {
    "container": ".associates-list .associate-item, .relatives-section .person-card, .possible-relatives .card",
    "name": ".associate-name, .person-name, .relative-name",
    "relationship": ".associate-relationship, .relation-type, .relative-label"
  },
  "steps": [
    {
      "action": "web_search",
      "engine": "duckduckgo",
      "query": "\"{name}\" site:whitepages.com",
      "result_selector": ".result__body, .result__title, .results_links",
      "skip_if_no_results": true,
      "timeout_ms": 12000,
      "_comment": "Phase 1: threat assessment — confirm member is listed on WhitePages before opening a browser session there"
    },
    {
      "action": "navigate",
      "url": "https://www.whitepages.com/name/{name}/{state}",
      "timeout_ms": 15000,
      "_comment": "Phase 2: go to the public people-search page to see actual exposure and extract associates"
    },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running",
        ".cf-challenge-running"
      ]
    },
    {
      "action": "wait",
      "selector": ".card-section, .people-card, .profile-card, .no-results",
      "timeout_ms": 10000
    },
    { "action": "extract_associates" },
    {
      "action": "navigate",
      "url": "https://www.whitepages.com/suppression-requests",
      "timeout_ms": 15000,
      "_comment": "Phase 3: opt-out form (separate URL from search)"
    },
    {
      "action": "detect_captcha",
      "selectors": [
        "iframe[src*='recaptcha']",
        ".g-recaptcha",
        "iframe[src*='hcaptcha']",
        "#challenge-running"
      ]
    },
    {
      "action": "fill",
      "selector": "input[name='name'], input[placeholder*='name' i], input[id='name']",
      "value_source": "member.name"
    },
    {
      "action": "fill",
      "selector": "input[name='phone'], input[placeholder*='phone' i], input[type='tel']",
      "value_source": "member.phone"
    },
    { "action": "click", "selector": "button[type='submit'], input[type='submit'], .search-submit" },
    { "action": "wait", "selector": ".search-results, .suppression-results, .listing-item, .no-results", "timeout_ms": 10000 },
    {
      "action": "click",
      "selector": ".opt-out-link, a[href*='opt-out'], button[data-action='remove'], .remove-listing"
    },
    { "action": "wait", "selector": ".confirmation, .success-message, .request-submitted", "timeout_ms": 10000 },
    {
      "action": "detect_success",
      "indicators": [
        "text:Your request has been submitted",
        "text:suppression request",
        "text:successfully submitted",
        "selector:.confirmation-message"
      ]
    }
  ]
}
